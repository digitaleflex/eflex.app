[Unit]
Description=Eflex — sauvegarde PostgreSQL (pg_dump + gzip)
Documentation=file:///home/fantome/eflex/docs/operations/backups.md
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=fantome
Group=fantome
WorkingDirectory=/home/fantome/eflex
Environment=EFLEX_ENV_FILE=/home/fantome/eflex/.env.prod
Environment=EFLEX_BACKUP_DIR=/home/fantome/backups/eflex
ExecStart=/bin/bash /home/fantome/eflex/scripts/backup-db.sh
SyslogIdentifier=eflex-backup
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=30min
# Durcissement raisonnable : le script n'a besoin que de Docker (socket),
# du dépôt en lecture et du dossier de sauvegardes en écriture.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=no
