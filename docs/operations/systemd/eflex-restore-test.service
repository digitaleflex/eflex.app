[Unit]
Description=Eflex — test de restauration sur base jetable
Documentation=file:///home/fantome/eflex/docs/operations/backups.md
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=fantome
Group=fantome
WorkingDirectory=/home/fantome/eflex
Environment=EFLEX_ENV_FILE=/home/fantome/eflex/.env.prod
Environment=EFLEX_BACKUP_DIR=/home/fantome/backups/eflex
ExecStart=/bin/bash /home/fantome/eflex/scripts/restore-test.sh
SyslogIdentifier=eflex-restore-test
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=30min
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=no
