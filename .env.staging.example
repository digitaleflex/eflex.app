# ---------------------------------------------------------------------------
# Variables d'environnement — STAGING Eflex
# ---------------------------------------------------------------------------
# Copier vers `.env.staging` (fichier ignoré par git) puis remplacer TOUTES les
# valeurs par des secrets propres au staging :
#
#   cp .env.staging.example .env.staging
#   openssl rand -base64 32        # BETTER_AUTH_SECRET
#   openssl rand -base64 32        # ENV_ENCRYPTION_KEY
#   openssl rand -hex 24           # POSTGRES_PASSWORD
#   openssl rand -hex 24           # REDIS_PASSWORD
#
# Ne JAMAIS copier tel quel `.env.prod` : le staging doit avoir sa base, son
# Redis et ses secrets. Voir docs/operations/staging.md.
# ---------------------------------------------------------------------------

# --- Domaine et exposition ---------------------------------------------------
# Seul domaine autorisé à être écrit en dur dans la configuration staging.
STAGING_DOMAIN=staging.eflex.app
STAGING_PORTAL_PORT=3001
# Dérivés du domaine (surchargeables, mais doivent rester cohérents avec lui).
PORTAL_URL=https://staging.eflex.app
PORTAL_DOMAIN=staging.eflex.app
BETTER_AUTH_URL=https://staging.eflex.app

# --- Base de données (dédiée au staging) -------------------------------------
POSTGRES_USER=eflex_staging
POSTGRES_PASSWORD=CHANGEZ_MOI_mot_de_passe_staging_postgres
POSTGRES_DB=eflex_staging
# Hôte = conteneur `eflex-staging-postgres` (réseau eflex-staging-internal).
# La base DOIT s'appeler eflex_staging : deploy-staging.sh refuse de démarrer
# si l'URL pointe vers `/eflex` (base de production).
DATABASE_URL="postgresql://eflex_staging:CHANGEZ_MOI_mot_de_passe_staging_postgres@eflex-staging-postgres:5432/eflex_staging?schema=public"

# --- Redis dédié (mot de passe obligatoire) ----------------------------------
REDIS_PASSWORD=CHANGEZ_MOI_mot_de_passe_staging_redis
# Format : redis://:<mot_de_passe>@eflex-staging-redis:6379
REDIS_URL="redis://:CHANGEZ_MOI_mot_de_passe_staging_redis@eflex-staging-redis:6379"

# --- Portail ----------------------------------------------------------------
DEPLOYMENT_TIMEOUT_MINUTES=30
# Multi-applications (D2, lot C) : 1 pour autoriser plusieurs applications d'un
# même dépôt dans un seul projet. Vide ou 0 : création strictement mono-app.
EFLEX_MULTI_APP=
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=""
# Laisser vide : le moteur Axiom n'est pas surveillé depuis le staging.
STATUS_ENGINE_URL=""

# --- Authentification Better Auth -------------------------------------------
# openssl rand -base64 32 — secret PROPRE au staging.
BETTER_AUTH_SECRET=CHANGEZ_MOI_secret_better_auth_staging
# Administrateurs : uniquement des adresses de test, jamais un compte de prod.
ADMIN_EMAILS=admin-staging@example.com

# --- Chiffrement des variables d'environnement ------------------------------
# openssl rand -base64 32 — clé PROPRE au staging, différente de la production.
# La valeur ci-dessous n'est PAS une clé valide : elle fait échouer le démarrage
# tant qu'elle n'a pas été remplacée (garde-fou volontaire).
ENV_ENCRYPTION_KEY=CHANGEZ_MOI_cle_de_chiffrement_staging
# Ancienne clé pendant une rotation (facultatif).
ENV_ENCRYPTION_KEY_PREVIOUS=

# --- E-mails (facultatif) ----------------------------------------------------
# Laisser vide pour désactiver l'envoi (les liens restent dans les logs).
# Sinon utiliser une clé Resend de test et un expéditeur staging.
RESEND_API_KEY=
EMAIL_FROM="Eflex Staging <no-reply@staging.eflex.app>"
RESEND_WEBHOOK_SECRET=

# --- Coolify : cible séparée de la production --------------------------------
# Laisser URL et jeton VIDES pour un staging purement local : aucune création
# d'application distante. Si le staging pilote réellement Coolify, utiliser un
# jeton dédié et un projet/environnement dédiés.
COOLIFY_API_URL=
COOLIFY_API_TOKEN=
COOLIFY_PROJECT_NAME=Eflex Staging
COOLIFY_ENVIRONMENT=staging
COOLIFY_PROJECT_UUID=
COOLIFY_SERVER_UUID=

# --- GitHub (facultatif) -----------------------------------------------------
# Jeton de lecture sans droits : relève seulement la limite d'API.
GITHUB_TOKEN=
# GitHub App : créer une App de test dédiée si le staging en a besoin.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# --- Google OAuth (facultatif) ----------------------------------------------
# URI de redirection à déclarer : https://staging.eflex.app/api/auth/callback/google
# Origine JavaScript autorisée : https://staging.eflex.app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Captcha Cloudflare Turnstile (facultatif) -------------------------------
# Laisser vide pour désactiver le captcha sur le staging.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Paiements : SANDBOX uniquement -----------------------------------------
# Ne jamais mettre ici de clés de production.
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET_KEY=
KKIAPAY_SANDBOX=true
KKIAPAY_WEBHOOK_SECRET=
FEDAPAY_SECRET_KEY=
FEDAPAY_SANDBOX=true
FEDAPAY_WEBHOOK_SECRET=

# --- Mentions de facture (valeurs de test) -----------------------------------
INVOICE_COMPANY_NAME=Eflex Staging
INVOICE_COMPANY_ADDRESS=
INVOICE_COMPANY_EMAIL=facturation@staging.eflex.app
INVOICE_TAX_ID=
