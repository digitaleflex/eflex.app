generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Authentification (Better Auth) ─────────────────────────────────────────
// Modèles attendus par better-auth : user, session, account, verification.
// Le mot de passe e-mail est stocké dans Account.password (providerId = "credential").
model User {
  id                      String                   @id @default(cuid())
  name                    String
  email                   String                   @unique
  emailVerified           Boolean                  @default(false)
  image                   String?
  // Plugin admin : rôle plateforme ("user" | "admin"), suspension.
  role                    String?
  banned                  Boolean                  @default(false)
  banReason               String?
  banExpires              DateTime?
  twoFactorEnabled        Boolean                  @default(false)
  twoFactor               TwoFactor[]
  passkeys                Passkey[]
  sessions                Session[]
  accounts                Account[]
  projects                Project[]
  members                 Member[]
  invitations             Invitation[]             @relation("InvitationInviter")
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  gitInstallations        GitInstallation[]
  gitPat                  GitPat?
  payments                Payment[]
  supportTickets          SupportTicket[]          @relation("SupportTicketAuthor")
  assignedSupportTickets  SupportTicket[]          @relation("SupportTicketAssignee")
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
}

model Session {
  id                   String   @id @default(cuid())
  expiresAt            DateTime
  token                String   @unique
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Plugin organization : organisation active. Plugin admin : usurpation.
  activeOrganizationId String?
  impersonatedBy       String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

/**
 * Secrets TOTP et codes de secours (plugin Better Auth two-factor).
 */
model TwoFactor {
  id                      String    @id @default(cuid())
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret                  String
  backupCodes             String
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?

  @@index([userId])
}

/**
 * Clés WebAuthn (plugin Better Auth passkey).
 */
model Passkey {
  id           String   @id @default(cuid())
  name         String?
  publicKey    String
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime @default(now())
  aaguid       String?

  @@index([userId])
  @@index([credentialID])
}

/**
 * Compteurs du limiteur Better Auth en base (partagés entre instances).
 */
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

model Project {
  id                    String            @id @default(cuid())
  organizationId        String
  organization          Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId                String // créateur du projet
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                  String
  slug                  String            @unique // ex: "mon-projet-42"
  repoUrl               String
  branch                String            @default("main")
  /**
   * Dépôt au format « proprietaire/nom » et installation GitHub App liée (issue 07).
   */
  repoFullName          String?
  installationId        String?
  productionBranch      String?
  repoPrivate           Boolean           @default(false)
  // Dépôt privé : deploy key créée dans le dépôt GitHub et clé privée correspondante dans Coolify.
  githubDeployKeyId     Int?
  coolifyPrivateKeyUuid String?
  // Dernier contrôle TLS effectué après un déploiement (lib/tls.ts).
  tlsValid              Boolean?
  tlsExpiresAt          DateTime?
  tlsCheckedAt          DateTime?
  framework             String // laravel, nextjs, node, python, static
  runtime               String? // node@22, php@8.3, etc.
  domain                String? // domaine client, sans protocole
  coolifyAppId          String? // ID côté Coolify (null jusqu'au premier déploiement)
  plan                  Json? // BuildPlan retenu à la création (voir packages/detector)
  detection             Json? // résultat de l'analyse : confiance, raisons, avertissements, commit
  port                  Int               @default(80)
  /// Prévisualisations PR/MR activées explicitement (MVP #185, désactivé par défaut).
  previewsEnabled       Boolean           @default(false)
  envVars               EnvVar[]
  deployments           Deployment[]
  domains               ProjectDomain[]
  databases             ProjectDatabase[]
  /**
   * Applications déployables du projet (D2, lot B). Un projet sans ligne
   * `ProjectApp` (données antérieures au backfill) reste traité comme une
   * application implicite décrite par les colonnes `plan`/`framework`/`port`/
   * `domain`/`coolifyAppId` ci-dessus, qui servent de miroir de l'application
   * principale pendant la transition.
   */
  apps                  ProjectApp[]
  previews              ProjectPreview[]
  supportTickets        SupportTicket[]
  analytics             ProjectAnalytics?
  trafficStats          TrafficDailyStat[]
  trafficSiteStats      TrafficDailySiteStat[]
  eventStats            AnalyticsEventDaily[]
  analyticsDailyVisitors AnalyticsDailyVisitor[]
  trafficDimensions     TrafficDailyDimension[]
  analyticsDimensionVisitors AnalyticsDailyDimensionVisitor[]
  siteMonitors          ProjectSiteMonitor[]
  siteIncidents         ProjectSiteIncident[]
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([userId])
  @@index([organizationId])
  @@index([slug])
}

/**
 * Application déployable d'un projet (D2, lot B) : un dossier du dépôt, un
 * build Coolify, un port, éventuellement un domaine public. Le `BuildPlan`
 * (contrat `schema/v1.json`) est celui de l'application, pas du dépôt.
 * `plan` est obligatoire : le worker refuse déjà un projet dépourvu de plan
 * valide, donc une application sans plan ne serait pas déployable.
 * `domain` n'est unique que lorsqu'il est renseigné (PostgreSQL ignore les
 * NULL) : une application interne non exposée n'a pas de domaine.
 */
model ProjectApp {
  id           String           @id @default(cuid())
  projectId    String
  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /**
   * Nom court stable et unique dans le projet : "web", "api", "admin".
   */
  name         String
  /**
   * Dossier de l'application dans le dépôt ("" = racine).
   */
  root         String           @default("")
  /**
   * Ordre d'affichage déterministe (application principale = 0).
   */
  position     Int              @default(0)
  plan         Json
  framework    String
  runtime      String?
  port         Int              @default(80)
  /**
   * Domaine public de l'application. null = application non exposée.
   */
  domain       String?          @unique
  coolifyAppId String?
  tlsValid     Boolean?
  tlsExpiresAt DateTime?
  tlsCheckedAt DateTime?
  envVars      EnvVar[]
  deployments  Deployment[]
  domains      ProjectDomain[]
  previews     ProjectPreview[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([projectId, name])
  @@unique([projectId, root])
  @@index([projectId])
  @@index([coolifyAppId])
}

/**
 * Prévisualisation de pull/merge request (#185, MVP). Une ligne par (app, PR).
 * Les URL et statuts viennent de Coolify ; aucun secret n'est stocké. `active`
 * = preview ouverte côté Coolify, `closed` = supprimée à la fermeture de la PR,
 * `failed`/`unsupported` = création ou mise à jour impossible (instance Coolify
 * sans previews, droits manquants, app non prête, etc.).
 */
model ProjectPreview {
  id                   String     @id @default(cuid())
  projectId            String
  project              Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  appId                String
  app                  ProjectApp @relation(fields: [appId], references: [id], onDelete: Cascade)
  prNumber             Int
  prTitle              String?
  prUrl                String?
  headRef              String
  headSha              String?
  baseRef              String?
  authorLogin          String?
  status               String     @default("active") // active | updating | closed | failed | unsupported
  previewUrl           String?
  coolifyDeploymentUuid String?
  error                String?    @db.Text
  lastDeployedAt       DateTime?
  closedAt             DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@unique([projectId, appId, prNumber])
  @@index([projectId, status])
  @@index([appId])
}

/**
 * Domaine personnalisé rattaché à un projet. Le domaine auto-généré reste
 * `Project.domain` ; ces entrées sont des alias (client, www…).
 */
model ProjectDomain {
  id           String      @id @default(cuid())
  projectId    String
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /**
   * Application ciblée (D2). null = alias de portée projet : il reste appliqué
   * à l'application principale pendant la transition (comportement actuel).
   */
  appId        String?
  app          ProjectApp? @relation(fields: [appId], references: [id], onDelete: Cascade)
  hostname     String      @unique
  verifiedAt   DateTime?
  tlsValid     Boolean?
  tlsExpiresAt DateTime?
  tlsCheckedAt DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([projectId])
  @@index([appId])
}

/**
 * Base de données managée par Eflex (PostgreSQL ou Redis), hébergée par
 * l'infrastructure et accessible uniquement depuis le réseau Docker.
 * L'URL interne contient le mot de passe : elle est chiffrée au repos et
 * n'est jamais renvoyée à l'interface.
 */
model ProjectDatabase {
  id                String   @id @default(cuid())
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind              String // postgresql | redis
  coolifyId         String   @unique
  name              String
  status            String?
  internalUrl       String   @db.Text // AES-256-GCM, AAD project-db:<projectId>:<kind>
  /// Planification de sauvegarde Coolify (PostgreSQL uniquement ; null = pas encore planifiée).
  backupId          String?
  /// Date de la planification (sert à ne pas alerter avant la première sauvegarde attendue).
  backupScheduledAt          DateTime?
  /// Preuve de restauration : dernière tentative et dernière réussite consignée.
  lastRestoreExecutionId            String?
  lastRestoreBackupCreatedAt        DateTime?
  lastRestoreImportId               String?
  lastRestoreStartedAt              DateTime?
  lastRestoreFinishedAt             DateTime?
  lastRestoreStatus                 String? // running | finished | failed
  lastSuccessfulRestoreAt           DateTime?
  lastSuccessfulRestoreBackupCreatedAt DateTime?
  createdAt                         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([projectId, kind])
  @@index([projectId])
}

model EnvVar {
  id        String      @id @default(cuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /**
   * Application ciblée (D2). null = variable de portée projet, diffusée à
   * toutes les applications. L'unicité `(projectId, key)` ci-dessous ne couvre
   * aujourd'hui que ce cas ; un index unique partiel SQL
   * (`EnvVar_project_scope_key`, WHERE "appId" IS NULL) garantit la même
   * propriété quand la portée par application arrivera (lot C/D).
   */
  appId     String?
  app       ProjectApp? @relation(fields: [appId], references: [id], onDelete: Cascade)
  key       String // ex: DATABASE_URL, NEXT_PUBLIC_URL
  value     String // AES-256-GCM : v1:<nonce base64>:<ciphertext+tag base64> (voir lib/crypto.ts)
  updatedAt DateTime    @updatedAt

  @@unique([projectId, key])
  @@index([projectId])
  @@index([appId])
}

model Deployment {
  id             String      @id @default(cuid())
  projectId      String
  project        Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /**
   * Application déployée (D2). null = déploiement antérieur à D2 (ou app
   * supprimée) : les lectures le rattachent à l'application principale.
   * `SetNull` conserve l'historique de déploiement quand une application est
   * retirée du projet ; la suppression du projet supprime bien les lignes via
   * `projectId` (Cascade).
   */
  appId          String?
  app            ProjectApp? @relation(fields: [appId], references: [id], onDelete: SetNull)
  /**
   * Lot commun aux N déploiements créés par un même événement (push, redéploiement global).
   */
  groupId        String?
  commitSha      String
  /** Retour arrière : la cible est `commitSha` (nécessaire pour ré-enfiler un job perdu). */
  rollback       Boolean     @default(false)
  status         String      @default("pending") // pending, building, deploying, live, failed, rollbacked
  coolifyBuildId String?
  logsSummary    String?     @db.Text
  createdAt      DateTime    @default(now())
  supportTickets SupportTicket[]

  @@index([projectId])
  @@index([status])
  @@index([appId])
  @@index([groupId])
}

model Subscription {
  id                   String       @id @default(cuid())
  organizationId       String       @unique
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  status               String       @default("active") // active, trialing, pending, past_due, cancelled
  plan                 String       @default("free")
  /**
   * Plan demandé, conservé jusqu'à l'activation par un administrateur.
   */
  pendingPlan          String?
  priceFcfa            Int          @default(0)
  providerRef          String? // identifiant Stripe/Paddle/facture externe
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean      @default(false)
  /**
   * Fin de la période de grâce après un impayé (`past_due`). Pendant la grâce,
   * les limites du plan payant restent actives ; après, les nouveaux
   * déploiements sont bloqués mais les applications en ligne restent intactes.
   */
  graceUntil           DateTime?
  /**
   * Changement manuel effectué par un administrateur (geste commercial).
   * Un webhook de paiement ne doit jamais l'écraser silencieusement : il
   * enregistre alors le plan demandé dans `pendingPlan`.
   */
  manualOverride       Boolean      @default(false)
  manualOverrideAt     DateTime?
  manualOverrideBy     String?
  manualOverrideReason String?
  /**
   * Crédit interne (prorata) en FCFA, déduit du prochain paiement.
   */
  creditFcfa           Int          @default(0)
  /**
   * Dérive temporaire des quotas accordée par un administrateur.
   */
  projectLimitOverride Int?
  memberLimitOverride  Int?
  quotaOverrideUntil   DateTime?
  /**
   * Note interne visible des administrateurs (motif du dernier geste).
   */
  note                 String?      @db.Text
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([organizationId])
  @@index([graceUntil])
}

/**
 * Paiement en ligne (Kkiapay ou FedaPay). `reference` est notre identifiant
 * interne, transmis au prestataire pour corréler le webhook sans faire
 * confiance aux données du client.
 */
model Payment {
  id             String       @id @default(cuid())
  reference      String       @unique
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan           String
  provider       String // kkiapay | fedapay
  providerRef    String? // identifiant de transaction chez le prestataire
  amountFcfa     Int
  /**
   * Part du prix couverte par un crédit interne (prorata) au moment du paiement.
   */
  creditFcfa     Int          @default(0)
  status         String       @default("pending") // pending, approved, declined, canceled, expired
  invoiceNumber  String?      @unique
  invoicedAt     DateTime?
  refundedAt     DateTime?
  refundRef      String?
  refundStatus   String? // requested, refunded, failed
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([provider, providerRef])
  @@index([organizationId])
  @@index([status])
}

// ─── GitHub App (issue 07) ──────────────────────────────────────────────────
model GitInstallation {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  installationId String   @unique
  accountLogin   String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

/**
 * Jeton personnel GitHub (PAT) : solution de repli quand la GitHub App n'est pas
 * installée sur le compte ou l'organisation du dépôt. Le jeton est chiffré au repos
 * (AAD `github-pat:<userId>`) et n'est jamais renvoyé au client.
 */
model GitPat {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  login     String
  token     String   @db.Text
  scopes    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * Configuration de la plateforme modifiable depuis l'admin (GitHub App créée via
 * le flux manifest). Les valeurs sensibles sont chiffrées avec `lib/crypto.ts`.
 */
model PlatformSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

/**
 * Idempotence des webhooks : une livraison `X-GitHub-Delivery` n'est traitée qu'une fois.
 */
model WebhookDelivery {
  id        String   @id
  createdAt DateTime @default(now())
}

// ─── Statut public / supervision ────────────────────────────────────────────
// Un relevé par composant, écrit au plus une fois par minute (voir lib/status.ts).
model StatusCheck {
  id        String   @id @default(cuid())
  checkedAt DateTime @default(now())
  component String
  status    String // ok | degraded | down | unknown
  latencyMs Int?

  @@index([checkedAt])
  @@index([component, checkedAt])
}

model StatusIncident {
  id          String    @id @default(cuid())
  title       String
  description String?   @db.Text
  severity    String    @default("minor") // minor | major | critical
  status      String    @default("investigating") // investigating | identified | monitoring | resolved
  startedAt   DateTime  @default(now())
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([startedAt])
}

// ─── Multi-tenant (plugin organization) ─────────────────────────────────────
// Tout projet appartient à une organisation. Chaque utilisateur a une organisation
// personnelle créée à l'inscription. Rôles : owner, admin, member.
model Organization {
  id               String               @id @default(cuid())
  name             String
  slug             String               @unique
  logo             String?
  metadata         String?              @db.Text
  /**
   * Suspension administrative : gèle la création de projets et les nouveaux
   * déploiements. Aucune donnée ni application en ligne n'est supprimée.
   */
  suspendedAt      DateTime?
  suspensionReason String?              @db.Text
  /// Réseau Docker dédié (destination Coolify), créé à la demande quand EFLEX_ORG_NETWORKS=1 (S5, #171).
  coolifyDestinationUuid String?
  createdAt        DateTime             @default(now())
  members          Member[]
  invitations      Invitation[]
  projects         Project[]
  subscription     Subscription?
  payments         Payment[]
  supportTickets   SupportTicket[]
  siteMonitors     ProjectSiteMonitor[]
  siteIncidents    ProjectSiteIncident[]

  @@index([suspendedAt])
}

model Member {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  inviterId      String
  inviter        User         @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([email])
}

// ─── Administration de la plateforme ────────────────────────────────────────
// Journal d'audit en ajout seul : aucune route ne le modifie ni ne le supprime.
// `details` ne contient jamais de secret (valeurs de variables, jetons, mots de passe).
model AuditLog {
  id             String   @id @default(cuid())
  actorId        String?
  actorEmail     String // dénormalisé : l'entrée reste lisible si le compte est supprimé
  action         String // ex: "user.ban", "user.unban"
  targetType     String // user | organization | project | deployment | …
  targetId       String
  organizationId String?
  details        Json?
  ip             String?
  userAgent      String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([targetType, targetId])
  @@index([organizationId])
}

// ─── Temps réel ─────────────────────────────────────────────────────────────
// Bus d'événements : un seul flux SSE par onglet (/api/events). Les identifiants croissent,
// ce qui permet la reprise (Last-Event-ID). Les charges utiles ne contiennent jamais de secret.
// audience : "org" (membres de l'organisation), "admin" (administrateurs), "user" (un utilisateur).
model Event {
  id             BigInt   @id @default(autoincrement())
  type           String
  audience       String   @default("org")
  organizationId String?
  userId         String?
  payload        Json
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([organizationId, id])
}

// ─── Notifications ──────────────────────────────────────────────────────────
// `dedupeKey` rend l'envoi idempotent : deux chemins qui constatent le même changement de statut
// ne créent qu'une notification. Les textes ne contiennent jamais de secret.
model Notification {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  type           String
  title          String
  body           String?   @db.Text
  href           String?
  dedupeKey      String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
}

// On ne stocke que les choix explicites : l'absence de ligne signifie « activé ».
model NotificationPreference {
  id      String  @id @default(cuid())
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type    String
  channel String  @default("app") // app (e-mail : voir issue sur les e-mails transactionnels)
  enabled Boolean

  @@unique([userId, type, channel])
}

// ─── Mesure de trafic (ANALYTICS-2, socle initial) ─────────────────────────
// Collecte activable, désactivée par défaut (opt-in, #112). Aucune donnée sans
// source mesurée : événements reçus via le snippet/SDK public authentifié par
// une clé d'écriture. Minimisation : pas d'IP brute, pas d'identifiant visiteur,
// pas de profilage nominatif ; agrégation quotidienne par chemin. La rétention
// est configurable (nettoyage/purge à brancher dans #112).
model ProjectAnalytics {
  id             String    @id @default(cuid())
  projectId      String    @unique
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Mesure désactivée par défaut : ne collecte rien tant qu'elle n'est pas activée explicitement.
  enabled        Boolean   @default(false)
  /// Clé publique d'écriture embarquée dans le snippet (identifie le projet). Montrée uniquement aux gestionnaires.
  publicKey      String    @unique
  /// Respect du signal « Do Not Track » / Global Privacy Control (GPC) : si actif, ces visites sont ignorées.
  respectDnt     Boolean   @default(true)
  /// Collecte du chemin de page (agrégé par jour). Désactivable pour ne garder qu'un volume global.
  collectPath    Boolean   @default(true)
  /// Collecte agrégée du référent (domaine/source) sur les pages vues.
  collectReferrer Boolean  @default(true)
  /// Collecte agrégée appareil/navigateur/OS (dérivés du User-Agent) sur les pages vues.
  collectDevice   Boolean  @default(true)
  /// Collecte agrégée du pays (GeoIP locale, IP jamais stockée). Ignorée si la base GeoIP est indisponible.
  collectCountry  Boolean  @default(true)
  /// Collecte agrégée des paramètres de campagne UTM (source, medium, campaign) sur les pages vues.
  collectUtm      Boolean  @default(true)
  /// Durée de conservation cible des statistiques quotidiennes (jours). Borne appliquée côté API.
  retentionDays  Int       @default(90)
  /// Noms d'événements considérés comme objectifs de conversion (#111). Liste bornée, sans propriétés ni données nominatives.
  goalEvents     String[]  @default([])
  /// Dernière mesure réellement reçue et comptabilisée (page vue ou événement). Sert à vérifier l'installation.
  lastReceivedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  alerts         AnalyticsAlert[]

  @@index([projectId])
}

/// Statistique quotidienne agrégée (aucune donnée nominative, aucun identifiant visiteur).
model TrafficDailyStat {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Jour UTC de la mesure.
  date      DateTime @db.Date
  /// Chemin normalisé (sans requête ni fragment), ou "/" si la collecte de chemin est désactivée.
  path      String   @db.VarChar(500)
  /// Nombre de pages vues agrégées reçues pour ce chemin et ce jour.
  views     Int      @default(0)

  @@unique([projectId, date, path])
  @@index([projectId, date])
}

/// Totaux quotidiens site/projet (vues et visiteurs uniques du jour). Agrégat dérivé des mesures reçues.
model TrafficDailySiteStat {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Jour UTC de la mesure.
  date      DateTime @db.Date
  /// Nombre total de pages vues comptées ce jour.
  views     Int      @default(0)
  /// Nombre de visiteurs uniques comptés ce jour (déduplication privacy-friendly, par jour uniquement).
  visitors  Int      @default(0)

  @@unique([projectId, date])
  @@index([projectId, date])
}

/// Empreinte éphémère de déduplication des visiteurs uniques par jour (hash non réversible, sel quotidien).
/// Ne contient ni IP ni identifiant persistant ; sert uniquement à éviter de recompter un visiteur le même jour.
model AnalyticsDailyVisitor {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Jour UTC concerné.
  date      DateTime @db.Date
  /// Empreinte HMAC hex (64 chars) dérivée de (IP, User-Agent) avec un sel rotatif quotidien.
  hash      String   @db.VarChar(64)

  @@unique([projectId, date, hash])
  @@index([projectId, date])
}

/// Agrégat quotidien par dimension (référent, appareil, navigateur, OS). Valeurs bornées/normalisées, sans donnée brute.
model TrafficDailyDimension {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  /// Dimension : referrer | device | browser | os
  dimension String   @db.VarChar(32)
  /// Valeur normalisée (domaine, direct, desktop/mobile/..., nom navigateur/OS).
  value     String   @db.VarChar(255)
  views     Int      @default(0)
  visitors  Int      @default(0)

  @@unique([projectId, date, dimension, value])
  @@index([projectId, date, dimension])
}

/// Déduplication visiteurs uniques par segment de dimension et par jour (même empreinte journalière que P0).
model AnalyticsDailyDimensionVisitor {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  dimension String   @db.VarChar(32)
  value     String   @db.VarChar(255)
  hash      String   @db.VarChar(64)

  @@unique([projectId, date, dimension, value, hash])
  @@index([projectId, date, dimension])
}

/// Statistique quotidienne agrégée d'événements nommés (#111). Aucun identifiant visiteur,
/// aucune propriété libre : uniquement un compteur par nom d'événement validé.
model AnalyticsEventDaily {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Jour UTC de la mesure.
  date      DateTime @db.Date
  /// Nom d'événement normalisé/validé (liste contrôlée côté API, bornée en longueur).
  name      String   @db.VarChar(64)
  /// Nombre d'occurrences agrégées reçues pour cet événement et ce jour.
  count     Int      @default(0)

  @@unique([projectId, date, name])
  @@index([projectId, date])
}

/// Alerte de trafic configurée sur les statistiques agrégées (#113). Seuils explicites,
/// évaluation planifiée sur des données réelles (pas de détection sur le chemin d'ingestion).
model AnalyticsAlert {
  id            String           @id @default(cuid())
  analyticsId   String
  analytics     ProjectAnalytics @relation(fields: [analyticsId], references: [id], onDelete: Cascade)
  /// Type d'alerte : hausse ou baisse de trafic.
  type          String
  /// Seuil de variation relative en pourcentage (ex. 50 = +50% ou -50%).
  thresholdPct  Int
  /// Volume minimal de référence (fenêtre précédente) pour éviter les faux positifs.
  minBaseline   Int              @default(20)
  /// Taille de la fenêtre évaluée en jours (comparée à la fenêtre précédente de même taille).
  windowDays    Int              @default(1)
  enabled       Boolean          @default(true)
  /// Délai minimal entre deux déclenchements (heures) pour éviter le spam.
  cooldownHours Int              @default(24)
  lastTriggeredAt DateTime?
  lastEvaluatedAt DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([analyticsId, type])
  @@index([analyticsId, enabled])
}

// ─── Support (tickets) ───────────────────────────────────────────────────────
// Tickets de support soumis par les utilisateurs (problème côté dépôt/client,
// question, incident). Les contenus ne doivent pas inclure de secrets.
model SupportTicket {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation("SupportTicketAuthor", fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  projectId      String?
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  deploymentId   String?
  deployment     Deployment?   @relation(fields: [deploymentId], references: [id], onDelete: SetNull)
  subject        String
  category       String        @default("general") // general | build | deploy | billing | account | other
  body           String        @db.Text
  status         String        @default("open") // open | in_progress | waiting_user | resolved | closed
  priority       String        @default("normal") // low | normal | high
  assignedToId   String?
  assignedTo     User?         @relation("SupportTicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  adminNote      String?       @db.Text
  resolvedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId, createdAt])
  @@index([organizationId, status, createdAt])
  @@index([status, createdAt])
  @@index([projectId])
  @@index([deploymentId])
}

// ─── Surveillance continue des sites clients (#177) ──────────────────────────
// Sondes HTTP/DNS/TLS sur les domaines connus du projet, incidents avec
// confirmation/dédoublonnage/cooldown et historique. Aucune donnée inter-locataire.
// Pas de secrets dans les erreurs ni les détails.
model ProjectSiteMonitor {
  id                  String                @id @default(cuid())
  projectId           String
  project             Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organizationId      String
  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Hôte public surveillé (domaine d'application ou domaine personnalisé vérifié), normalisé.
  host                String
  /// Libellé d'affichage (ex. "Application principale", "Domaine personnalisé").
  label               String?
  enabled             Boolean               @default(true)
  /// Dernier contrôle réalisé.
  lastCheckedAt       DateTime?
  /// Synthèse du dernier contrôle : unknown | up | down
  lastStatus          String                @default("unknown")
  lastHttpStatus      Int?
  lastLatencyMs       Int?
  lastDnsOk           Boolean?
  lastTlsOk           Boolean?
  lastTlsExpiresAt    DateTime?
  /// Dernière erreur expurgée (jamais de secret, jamais de corps de réponse).
  lastError           String?               @db.Text
  /// Échecs / réussites consécutifs pour la confirmation et la détection du rétablissement.
  consecutiveFailures  Int                   @default(0)
  consecutiveSuccesses Int                   @default(0)
  incidents           ProjectSiteIncident[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@unique([projectId, host])
  @@index([projectId, lastCheckedAt])
  @@index([organizationId, lastStatus])
  @@index([enabled, lastCheckedAt])
}

model ProjectSiteIncident {
  id                 String             @id @default(cuid())
  monitorId          String
  monitor            ProjectSiteMonitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  projectId          String
  project            Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organizationId     String
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  host               String
  /// État de l'incident : open | resolved
  status             String             @default("open")
  /// Cause dominante : http | dns | tls | timeout | network
  cause              String?
  summary            String
  details            String?            @db.Text
  openedAt           DateTime           @default(now())
  resolvedAt         DateTime?
  /// Horodatages des notifications envoyées (dédoublonnage/cooldown).
  openedNotifiedAt   DateTime?
  resolvedNotifiedAt DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([projectId, openedAt(sort: Desc)])
  @@index([organizationId, status, openedAt(sort: Desc)])
  @@index([monitorId, status, openedAt(sort: Desc)])
  @@index([status, openedAt(sort: Desc)])
}
