generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Authentification (Better Auth) ─────────────────────────────────────────
// Modèles attendus par better-auth : user, session, account, verification.
// Le mot de passe e-mail est stocké dans Account.password (providerId = "credential").
model User {
  id                      String                   @id @default(cuid())
  name                    String
  email                   String                   @unique
  emailVerified           Boolean                  @default(false)
  image                   String?
  // Plugin admin : rôle plateforme ("user" | "admin"), suspension.
  role                    String?
  banned                  Boolean                  @default(false)
  banReason               String?
  banExpires              DateTime?
  twoFactorEnabled        Boolean                  @default(false)
  twoFactor               TwoFactor[]
  passkeys                Passkey[]
  sessions                Session[]
  accounts                Account[]
  projects                Project[]
  members                 Member[]
  invitations             Invitation[]             @relation("InvitationInviter")
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  gitInstallations        GitInstallation[]
  gitPat                  GitPat?
  payments                Payment[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
}

model Session {
  id                   String   @id @default(cuid())
  expiresAt            DateTime
  token                String   @unique
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Plugin organization : organisation active. Plugin admin : usurpation.
  activeOrganizationId String?
  impersonatedBy       String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

/**
 * Secrets TOTP et codes de secours (plugin Better Auth two-factor).
 */
model TwoFactor {
  id                      String    @id @default(cuid())
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret                  String
  backupCodes             String
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?

  @@index([userId])
}

/**
 * Clés WebAuthn (plugin Better Auth passkey).
 */
model Passkey {
  id           String   @id @default(cuid())
  name         String?
  publicKey    String
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime @default(now())
  aaguid       String?

  @@index([userId])
  @@index([credentialID])
}

/**
 * Compteurs du limiteur Better Auth en base (partagés entre instances).
 */
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

model Project {
  id                    String            @id @default(cuid())
  organizationId        String
  organization          Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId                String // créateur du projet
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                  String
  slug                  String            @unique // ex: "mon-projet-42"
  repoUrl               String
  branch                String            @default("main")
  /**
   * Dépôt au format « proprietaire/nom » et installation GitHub App liée (issue 07).
   */
  repoFullName          String?
  installationId        String?
  productionBranch      String?
  repoPrivate           Boolean           @default(false)
  // Dépôt privé : deploy key créée dans le dépôt GitHub et clé privée correspondante dans Coolify.
  githubDeployKeyId     Int?
  coolifyPrivateKeyUuid String?
  // Dernier contrôle TLS effectué après un déploiement (lib/tls.ts).
  tlsValid              Boolean?
  tlsExpiresAt          DateTime?
  tlsCheckedAt          DateTime?
  framework             String // laravel, nextjs, node, python, static
  runtime               String? // node@22, php@8.3, etc.
  domain                String? // domaine client, sans protocole
  coolifyAppId          String? // ID côté Coolify (null jusqu'au premier déploiement)
  plan                  Json? // BuildPlan retenu à la création (voir packages/detector)
  detection             Json? // résultat de l'analyse : confiance, raisons, avertissements, commit
  port                  Int               @default(80)
  envVars               EnvVar[]
  deployments           Deployment[]
  domains               ProjectDomain[]
  databases             ProjectDatabase[]
  /**
   * Applications déployables du projet (D2, lot B). Un projet sans ligne
   * `ProjectApp` (données antérieures au backfill) reste traité comme une
   * application implicite décrite par les colonnes `plan`/`framework`/`port`/
   * `domain`/`coolifyAppId` ci-dessus, qui servent de miroir de l'application
   * principale pendant la transition.
   */
  apps                  ProjectApp[]
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([userId])
  @@index([organizationId])
  @@index([slug])
}

/**
 * Application déployable d'un projet (D2, lot B) : un dossier du dépôt, un
 * build Coolify, un port, éventuellement un domaine public. Le `BuildPlan`
 * (contrat `schema/v1.json`) est celui de l'application, pas du dépôt.
 * `plan` est obligatoire : le worker refuse déjà un projet dépourvu de plan
 * valide, donc une application sans plan ne serait pas déployable.
 * `domain` n'est unique que lorsqu'il est renseigné (PostgreSQL ignore les
 * NULL) : une application interne non exposée n'a pas de domaine.
 */
model ProjectApp {
  id           String          @id @default(cuid())
  projectId    String
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /**
   * Nom court stable et unique dans le projet : "web", "api", "admin".
   */
  name         String
  /**
   * Dossier de l'application dans le dépôt ("" = racine).
   */
  root         String          @default("")
  /**
   * Ordre d'affichage déterministe (application principale = 0).
   */
  position     Int             @default(0)
  plan         Json
  framework    String
  runtime      String?
  port         Int             @default(80)
  /**
   * Domaine public de l'application. null = application non exposée.
   */
  domain       String?         @unique
  coolifyAppId String?
  tlsValid     Boolean?
  tlsExpiresAt DateTime?
  tlsCheckedAt DateTime?
  envVars      EnvVar[]
  deployments  Deployment[]
  domains      ProjectDomain[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([projectId, name])
  @@unique([projectId, root])
  @@index([projectId])
  @@index([coolifyAppId])
}

/**
 * Domaine personnalisé rattaché à un projet. Le domaine auto-généré reste
 * `Project.domain` ; ces entrées sont des alias (client, www…).
 */
model ProjectDomain {
  id           String      @id @default(cuid())
  projectId    String
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /**
   * Application ciblée (D2). null = alias de portée projet : il reste appliqué
   * à l'application principale pendant la transition (comportement actuel).
   */
  appId        String?
  app          ProjectApp? @relation(fields: [appId], references: [id], onDelete: Cascade)
  hostname     String      @unique
  verifiedAt   DateTime?
  tlsValid     Boolean?
  tlsExpiresAt DateTime?
  tlsCheckedAt DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([projectId])
  @@index([appId])
}

/**
 * Base de données managée par Eflex (PostgreSQL ou Redis), hébergée par
 * l'infrastructure et accessible uniquement depuis le réseau Docker.
 * L'URL interne contient le mot de passe : elle est chiffrée au repos et
 * n'est jamais renvoyée à l'interface.
 */
model ProjectDatabase {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind        String // postgresql | redis
  coolifyId   String   @unique
  name        String
  status      String?
  internalUrl String   @db.Text // AES-256-GCM, AAD project-db:<projectId>:<kind>
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([projectId, kind])
  @@index([projectId])
}

model EnvVar {
  id        String      @id @default(cuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /**
   * Application ciblée (D2). null = variable de portée projet, diffusée à
   * toutes les applications. L'unicité `(projectId, key)` ci-dessous ne couvre
   * aujourd'hui que ce cas ; un index unique partiel SQL
   * (`EnvVar_project_scope_key`, WHERE "appId" IS NULL) garantit la même
   * propriété quand la portée par application arrivera (lot C/D).
   */
  appId     String?
  app       ProjectApp? @relation(fields: [appId], references: [id], onDelete: Cascade)
  key       String // ex: DATABASE_URL, NEXT_PUBLIC_URL
  value     String // AES-256-GCM : v1:<nonce base64>:<ciphertext+tag base64> (voir lib/crypto.ts)
  updatedAt DateTime    @updatedAt

  @@unique([projectId, key])
  @@index([projectId])
  @@index([appId])
}

model Deployment {
  id             String      @id @default(cuid())
  projectId      String
  project        Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /**
   * Application déployée (D2). null = déploiement antérieur à D2 (ou app
   * supprimée) : les lectures le rattachent à l'application principale.
   * `SetNull` conserve l'historique de déploiement quand une application est
   * retirée du projet ; la suppression du projet supprime bien les lignes via
   * `projectId` (Cascade).
   */
  appId          String?
  app            ProjectApp? @relation(fields: [appId], references: [id], onDelete: SetNull)
  /**
   * Lot commun aux N déploiements créés par un même événement (push, redéploiement global).
   */
  groupId        String?
  commitSha      String
  status         String      @default("pending") // pending, building, deploying, live, failed, rollbacked
  coolifyBuildId String?
  logsSummary    String?     @db.Text
  createdAt      DateTime    @default(now())

  @@index([projectId])
  @@index([status])
  @@index([appId])
  @@index([groupId])
}

model Subscription {
  id                   String       @id @default(cuid())
  organizationId       String       @unique
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  status               String       @default("active") // active, trialing, pending, past_due, cancelled
  plan                 String       @default("free")
  /**
   * Plan demandé, conservé jusqu'à l'activation par un administrateur.
   */
  pendingPlan          String?
  priceFcfa            Int          @default(0)
  providerRef          String? // identifiant Stripe/Paddle/facture externe
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean      @default(false)
  /**
   * Fin de la période de grâce après un impayé (`past_due`). Pendant la grâce,
   * les limites du plan payant restent actives ; après, les nouveaux
   * déploiements sont bloqués mais les applications en ligne restent intactes.
   */
  graceUntil           DateTime?
  /**
   * Changement manuel effectué par un administrateur (geste commercial).
   * Un webhook de paiement ne doit jamais l'écraser silencieusement : il
   * enregistre alors le plan demandé dans `pendingPlan`.
   */
  manualOverride       Boolean      @default(false)
  manualOverrideAt     DateTime?
  manualOverrideBy     String?
  manualOverrideReason String?
  /**
   * Crédit interne (prorata) en FCFA, déduit du prochain paiement.
   */
  creditFcfa           Int          @default(0)
  /**
   * Dérive temporaire des quotas accordée par un administrateur.
   */
  projectLimitOverride Int?
  memberLimitOverride  Int?
  quotaOverrideUntil   DateTime?
  /**
   * Note interne visible des administrateurs (motif du dernier geste).
   */
  note                 String?      @db.Text
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([organizationId])
  @@index([graceUntil])
}

/**
 * Paiement en ligne (Kkiapay ou FedaPay). `reference` est notre identifiant
 * interne, transmis au prestataire pour corréler le webhook sans faire
 * confiance aux données du client.
 */
model Payment {
  id             String       @id @default(cuid())
  reference      String       @unique
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan           String
  provider       String // kkiapay | fedapay
  providerRef    String? // identifiant de transaction chez le prestataire
  amountFcfa     Int
  /**
   * Part du prix couverte par un crédit interne (prorata) au moment du paiement.
   */
  creditFcfa     Int          @default(0)
  status         String       @default("pending") // pending, approved, declined, canceled, expired
  invoiceNumber  String?      @unique
  invoicedAt     DateTime?
  refundedAt     DateTime?
  refundRef      String?
  refundStatus   String? // requested, refunded, failed
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([provider, providerRef])
  @@index([organizationId])
  @@index([status])
}

// ─── GitHub App (issue 07) ──────────────────────────────────────────────────
model GitInstallation {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  installationId String   @unique
  accountLogin   String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

/**
 * Jeton personnel GitHub (PAT) : solution de repli quand la GitHub App n'est pas
 * installée sur le compte ou l'organisation du dépôt. Le jeton est chiffré au repos
 * (AAD `github-pat:<userId>`) et n'est jamais renvoyé au client.
 */
model GitPat {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  login     String
  token     String   @db.Text
  scopes    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * Configuration de la plateforme modifiable depuis l'admin (GitHub App créée via
 * le flux manifest). Les valeurs sensibles sont chiffrées avec `lib/crypto.ts`.
 */
model PlatformSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

/**
 * Idempotence des webhooks : une livraison `X-GitHub-Delivery` n'est traitée qu'une fois.
 */
model WebhookDelivery {
  id        String   @id
  createdAt DateTime @default(now())
}

// ─── Statut public / supervision ────────────────────────────────────────────
// Un relevé par composant, écrit au plus une fois par minute (voir lib/status.ts).
model StatusCheck {
  id        String   @id @default(cuid())
  checkedAt DateTime @default(now())
  component String
  status    String // ok | degraded | down | unknown
  latencyMs Int?

  @@index([checkedAt])
  @@index([component, checkedAt])
}

model StatusIncident {
  id          String    @id @default(cuid())
  title       String
  description String?   @db.Text
  severity    String    @default("minor") // minor | major | critical
  status      String    @default("investigating") // investigating | identified | monitoring | resolved
  startedAt   DateTime  @default(now())
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([startedAt])
}

// ─── Multi-tenant (plugin organization) ─────────────────────────────────────
// Tout projet appartient à une organisation. Chaque utilisateur a une organisation
// personnelle créée à l'inscription. Rôles : owner, admin, member.
model Organization {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  logo             String?
  metadata         String?       @db.Text
  /**
   * Suspension administrative : gèle la création de projets et les nouveaux
   * déploiements. Aucune donnée ni application en ligne n'est supprimée.
   */
  suspendedAt      DateTime?
  suspensionReason String?       @db.Text
  createdAt        DateTime      @default(now())
  members          Member[]
  invitations      Invitation[]
  projects         Project[]
  subscription     Subscription?
  payments         Payment[]

  @@index([suspendedAt])
}

model Member {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  inviterId      String
  inviter        User         @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([email])
}

// ─── Administration de la plateforme ────────────────────────────────────────
// Journal d'audit en ajout seul : aucune route ne le modifie ni ne le supprime.
// `details` ne contient jamais de secret (valeurs de variables, jetons, mots de passe).
model AuditLog {
  id             String   @id @default(cuid())
  actorId        String?
  actorEmail     String // dénormalisé : l'entrée reste lisible si le compte est supprimé
  action         String // ex: "user.ban", "user.unban"
  targetType     String // user | organization | project | deployment | …
  targetId       String
  organizationId String?
  details        Json?
  ip             String?
  userAgent      String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([targetType, targetId])
  @@index([organizationId])
}

// ─── Temps réel ─────────────────────────────────────────────────────────────
// Bus d'événements : un seul flux SSE par onglet (/api/events). Les identifiants croissent,
// ce qui permet la reprise (Last-Event-ID). Les charges utiles ne contiennent jamais de secret.
// audience : "org" (membres de l'organisation), "admin" (administrateurs), "user" (un utilisateur).
model Event {
  id             BigInt   @id @default(autoincrement())
  type           String
  audience       String   @default("org")
  organizationId String?
  userId         String?
  payload        Json
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([organizationId, id])
}

// ─── Notifications ──────────────────────────────────────────────────────────
// `dedupeKey` rend l'envoi idempotent : deux chemins qui constatent le même changement de statut
// ne créent qu'une notification. Les textes ne contiennent jamais de secret.
model Notification {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  type           String
  title          String
  body           String?   @db.Text
  href           String?
  dedupeKey      String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
}

// On ne stocke que les choix explicites : l'absence de ligne signifie « activé ».
model NotificationPreference {
  id      String  @id @default(cuid())
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type    String
  channel String  @default("app") // app (e-mail : voir issue sur les e-mails transactionnels)
  enabled Boolean

  @@unique([userId, type, channel])
}
