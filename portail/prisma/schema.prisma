generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Authentification (Better Auth) ─────────────────────────────────────────
// Modèles attendus par better-auth : user, session, account, verification.
// Le mot de passe e-mail est stocké dans Account.password (providerId = "credential").
model User {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  emailVerified Boolean       @default(false)
  image         String?
  sessions      Session[]
  accounts      Account[]
  projects      Project[]
  subscription  Subscription?
  gitInstallations GitInstallation[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Project {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  slug          String     @unique // ex: "mon-projet-42"
  repoUrl       String
  branch        String     @default("main")
  /** Dépôt au format « proprietaire/nom » et installation GitHub App liée (issue 07). */
  repoFullName  String?
  installationId String?
  productionBranch String?
  framework     String      // laravel, nextjs, node, python, static
  runtime       String?     // node@22, php@8.3, etc.
  domain        String?     // domaine client, sans protocole
  coolifyAppId  String?     // ID côté Coolify (null jusqu'au premier déploiement)
  plan          Json?       // BuildPlan retenu à la création (voir packages/detector)
  detection     Json?       // résultat de l'analyse : confiance, raisons, avertissements, commit
  port          Int         @default(80)
  envVars       EnvVar[]
  deployments   Deployment[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([userId])
  @@index([slug])
}

model EnvVar {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key       String   // ex: DATABASE_URL, NEXT_PUBLIC_URL
  value     String   // AES-256-GCM : v1:<nonce base64>:<ciphertext+tag base64> (voir lib/crypto.ts)
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@unique([projectId, key])
}

model Deployment {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  commitSha      String
  status         String   @default("pending") // pending, building, deploying, live, failed, rollbacked
  coolifyBuildId String?
  logsSummary    String?  @db.Text
  createdAt      DateTime @default(now())

  @@index([projectId])
  @@index([status])
}

model Subscription {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status           String   // active, cancelled, past_due, trialing
  plan             String   // starter, pro, agency
  priceCents       Int      @default(0)
  providerRef      String?
  currentPeriodEnd DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
}

// ─── GitHub App (issue 07) ──────────────────────────────────────────────────
model GitInstallation {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  installationId String   @unique
  accountLogin   String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

/** Idempotence des webhooks : une livraison `X-GitHub-Delivery` n'est traitée qu'une fois. */
model WebhookDelivery {
  id        String   @id
  createdAt DateTime @default(now())
}

// ─── Statut public / supervision ────────────────────────────────────────────
// Un relevé par composant, écrit au plus une fois par minute (voir lib/status.ts).
model StatusCheck {
  id        String   @id @default(cuid())
  checkedAt DateTime @default(now())
  component String
  status    String   // ok | degraded | down | unknown
  latencyMs Int?

  @@index([checkedAt])
  @@index([component, checkedAt])
}

model StatusIncident {
  id          String    @id @default(cuid())
  title       String
  description String?   @db.Text
  severity    String    @default("minor")        // minor | major | critical
  status      String    @default("investigating") // investigating | identified | monitoring | resolved
  startedAt   DateTime  @default(now())
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([startedAt])
}
