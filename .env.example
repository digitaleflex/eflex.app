# Copie ce fichier vers .env et adapte les valeurs sensibles.
# Ne jamais committer le .env réel.

# Base de données (PostgreSQL)
DATABASE_URL="postgresql://eflex:eflexpass@localhost:5432/eflex?schema=public"

# Cache / sessions (Redis)
REDIS_URL="redis://localhost:6379"

# Stockage S3-compatible (MinIO)
MINIO_ENDPOINT="http://localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="eflex-dev"

# Coolify (distant en dev — voir note dans le README)
COOLIFY_API_URL="https://coolify.votre-serveur.com/api/v1"
COOLIFY_API_TOKEN="votre_token_coolify"

# --- Authentification Better Auth ---
# Générez le secret avec : openssl rand -base64 32
BETTER_AUTH_SECRET="changez-moi-32-caracteres-aleatoires"
BETTER_AUTH_URL="http://localhost:3000"

# --- E-mails transactionnels : Resend (issue 05) ---
# Laisser vide en dev : aucun e-mail n'est envoyé, les liens restent en log.
RESEND_API_KEY=
EMAIL_FROM="Eflex <noreply@eflex.app>"
# Secret de signature des webhooks Resend (préfixe whsec_).
RESEND_WEBHOOK_SECRET=

# --- Chiffrement des variables d'environnement (issue 04) ---
# 32 octets aléatoires en base64 : openssl rand -base64 32
ENV_ENCRYPTION_KEY=
# Ancienne clé pendant une rotation (facultatif).
ENV_ENCRYPTION_KEY_PREVIOUS=

# Google OAuth (obtenez-les sur console.cloud.google.com)
# En dev, déclarer : http://localhost:3000/api/auth/callback/google
# En prod          : $GOOGLE_OAUTH_REDIRECT (voir config/domains.sh, source unique)
GOOGLE_CLIENT_ID="votre_google_client_id"
GOOGLE_CLIENT_SECRET="votre_google_client_secret"

# GitHub (facultatif) : relève la limite de requêtes de l'analyse des dépôts
# (60 par heure sans jeton, 5 000 avec). Un jeton SANS aucun droit suffit.
# Il ne sert qu'à api.github.com et ne donne jamais accès à des dépôts privés.
GITHUB_TOKEN=""

# --- GitHub App (issue 07) : laisser vide en développement local ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_SLUG=

# Portail
PORTAL_PORT=3000

# --- Statut public et maintenance ---
# MAINTENANCE_MODE=true : le site renvoie /maintenance en HTTP 503.
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=""
# URL du moteur Axiom sondée par /api/status (vide = « non surveillé »).
STATUS_ENGINE_URL=""