AXIOM_ENGINE_HOST=0.0.0.0
AXIOM_ENGINE_PORT=8080
AXIOM_ENGINE_VERSION=0.1.0-dev

DATABASE_URL=postgres://axiom:axiom@localhost:5432/axiom?sslmode=disable
AXIOM_DB_MAX_OPEN_CONNS=10
AXIOM_DB_MAX_IDLE_CONNS=5
AXIOM_DB_CONN_MAX_LIFETIME=30m
AXIOM_DB_REQUIRED=false

# Integration tests only.
AXIOM_TEST_DATABASE_URL=postgres://axiom:axiom@localhost:5432/axiom?sslmode=disable

# Secrets locaux de développement. Copier ce fichier vers `.env` (gitignoré)
# puis remplacer les valeurs, par exemple avec : openssl rand -base64 32
# Ils sont lus par docker-compose.dev.yml pour l'interpolation ; ne jamais
# committer de valeur réelle.
AXIOM_API_TOKEN=remplacer-par-un-jeton-local
AXIOM_SECRET_KEY=remplacer-par-une-cle-aleatoire
