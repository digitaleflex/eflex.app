# Exemple de configuration agent Axiom (issue #13). NE PAS COMMITER de fichier réel.
# Copier vers un emplacement sécurisé (ex. /etc/axiom-agent/axiom-agent.env, chmod 600).

AXIOM_ENV=production
AXIOM_SERVER_ID=srv_a_remplacer
AXIOM_ENGINE_URL=https://engine.example.tld
AXIOM_AGENT_VERSION=0.1.0

# Jeton bootstrap à usage unique : UNIQUEMENT pour le premier enregistrement.
# Supprimer cette variable après "agent registered" et redémarrer le service.
# AXIOM_AGENT_TOKEN=remplacer_par_token_bootstrap

AXIOM_AGENT_DATA_DIR=/var/lib/axiom-agent
AXIOM_AGENT_HEARTBEAT_INTERVAL=30s
AXIOM_DOCKER_BINARY=docker
AXIOM_TRAEFIK_DYNAMIC_DIR=/etc/traefik/dynamic

# Listener d'opérations direct : loopback par défaut (pas de TLS, ADR-0008/#88).
# Ne pas exposer publiquement sans comprendre les implications de sécurité.
# AXIOM_AGENT_LISTEN_ADDR=127.0.0.1:9401
# AXIOM_AGENT_ALLOW_PUBLIC_LISTENER=false
# AXIOM_AGENT_OPERATION_PATH=/api/v1/agent/operations

# TLS optionnel du listener (si utilisé en mode loopback/self-hosted contrôlé)
# AXIOM_AGENT_TLS_CERT=/etc/axiom-agent/tls/server.crt
# AXIOM_AGENT_TLS_KEY=/etc/axiom-agent/tls/server.key
