# Variables d'environnement pour la production du moteur Eflex
# Copie vers .env.prod et adapte avant de lancer docker compose -f docker-compose.prod.yml --env-file .env.prod up -d

# --- Base de données ---
POSTGRES_USER=eflex
POSTGRES_PASSWORD=CHANGEZ_MOI_mot_de_passe_fort
POSTGRES_DB=eflex
DATABASE_URL="postgresql://eflex:CHANGEZ_MOI_mot_de_passe_fort@eflex-postgres:5432/eflex"

# --- Cache / sessions ---
REDIS_URL="redis://eflex-redis:6379"
# Délai maximal d'un déploiement avant passage automatique en échec (minutes).
DEPLOYMENT_TIMEOUT_MINUTES=30
# Volumes persistants Coolify (validés sur staging) : 1 pour activer.
EFLEX_PERSISTENT_VOLUMES=
# Multi-applications (D2, lot C) : 1 pour autoriser plusieurs applications d'un
# même dépôt dans un seul projet. Vide ou 0 : création strictement mono-app.
EFLEX_MULTI_APP=

# --- Coolify (moteur de déploiement distant) ---
# Laisser les deux variables VIDES tant que Coolify n'est pas réellement branché :
# /api/status affichera alors « non surveillé » au lieu d'une fausse panne.
# Ne jamais laisser de valeur d'exemple en production.
COOLIFY_API_URL=
COOLIFY_API_TOKEN=
# Le jeton doit avoir les capacités read, write, deploy, delete et read:sensitive
# (création/suppression des bases managées, URLs internes, clés privées).
# Cible Coolify (défauts : projet « Eflex », environnement « production »).
# COOLIFY_PROJECT_NAME=Eflex
# COOLIFY_ENVIRONMENT=production
# COOLIFY_PROJECT_UUID=
# COOLIFY_SERVER_UUID=

# --- Domaines : SOURCE UNIQUE = config/domains.sh ---------------------------
# Ne PAS définir PORTAL_DOMAIN / PORTAL_URL / BETTER_AUTH_URL ici.
# deploy.sh source config/domains.sh (une seule variable : EFLEX_ROOT_DOMAIN).
# Après un changement de domaine : bash scripts/sync-domains.sh && bash deploy.sh

# --- Authentification Better Auth ---
# Générez le secret avec : openssl rand -base64 32
BETTER_AUTH_SECRET="changez-moi-32-caracteres-aleatoires"

# --- Administration de la plateforme ---
# Adresses (séparées par des virgules) qui deviennent administrateurs. Le rôle n'est accordé
# qu'à un compte dont l'e-mail est VÉRIFIÉ (connexion Google, ou lien de vérification Resend) :
# sans fournisseur d'e-mails, promouvoir un compte à la main (UPDATE "User" SET role='admin' …).
ADMIN_EMAILS=

# --- E-mails transactionnels : Resend (issue 05) ---
# 1. Vérifier le domaine eflex.app dans Resend (enregistrements DKIM/SPF à
#    ajouter chez le registrar), 2. créer une clé avec droit d'envoi.
# Tant que RESEND_API_KEY est vide, la vérification d'e-mail est désactivée :
# aucun compte ne peut être verrouillé sans pouvoir recevoir son lien.
RESEND_API_KEY=
EMAIL_FROM="Eflex <noreply@eflex.app>"
# Secret de signature des webhooks (Svix), fourni par Resend à la création du
# webhook. URL à déclarer : https://eflex.app/api/webhooks/
RESEND_WEBHOOK_SECRET=

# --- Alertes d'exploitation (facultatif) — scripts/healthcheck.sh -----------
# Webhook JSON (Slack, Mattermost, Rocket.Chat…) appelé uniquement en cas
# d'anomalie. Corps envoyé : {"text": "…"}. Laisser vide pour désactiver.
# ALERT_WEBHOOK_URL=
# Destinataire des alertes par e-mail via Resend (nécessite RESEND_API_KEY
# ci-dessus et un domaine expéditeur vérifié dans Resend).
# ALERT_EMAIL=

# --- Chiffrement des variables d'environnement (issue 04) ---
# OBLIGATOIRE : 32 octets aléatoires en base64. Ne jamais committer la valeur
# réelle, ni la placer dans l'image Docker (elle reste dans .env.prod).
#   openssl rand -base64 32
ENV_ENCRYPTION_KEY=
# Pour une rotation : ancienne clé, la nouvelle prenant sa place ci-dessus.
ENV_ENCRYPTION_KEY_PREVIOUS=

# GitHub (facultatif) : relève la limite de requêtes de l'analyse des dépôts
# (60 par heure sans jeton, 5 000 avec). Un jeton SANS aucun droit suffit.
GITHUB_TOKEN=""

# --- Paiement en ligne (Kkiapay / FedaPay) -----------------------------------
# Kkiapay : clés du tableau de bord + hash secret du webhook.
# Webhook Kkiapay : https://eflex.app/api/webhooks/kkiapay
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET_KEY=
KKIAPAY_SANDBOX=false
KKIAPAY_WEBHOOK_SECRET=
# FedaPay : clé secrète + secret du webhook (wh_...).
# Webhook FedaPay : https://eflex.app/api/webhooks/fedapay
FEDAPAY_SECRET_KEY=
FEDAPAY_SANDBOX=false
FEDAPAY_WEBHOOK_SECRET=
# Mentions affichées sur les factures PDF (facultatif).
INVOICE_COMPANY_NAME=Eflex
INVOICE_COMPANY_ADDRESS=
INVOICE_COMPANY_EMAIL=admin@eflex.app
INVOICE_TAX_ID=

# --- GitHub App (issue 07) : dépôts privés + webhook push ---------------------
# Deux méthodes :
#  1. recommandée : Paramètres → Connexion GitHub → « Créer l'application GitHub »
#     (admin). Le flux manifest crée l'App et stocke ses identifiants chiffrés en base.
#  2. manuelle : créer l'App sur https://github.com/settings/apps/new avec :
#     permissions : contents:read, metadata:read, administration:write
#     événements  : push (installation / installation_repositories sont automatiques)
#     URL webhook : https://eflex.app/api/webhooks/github
#     Setup URL   : https://eflex.app/dashboard/new (cocher « Redirect on update »)
#     Callback URL: https://eflex.app/api/github/oauth/callback
#     Renseigner aussi GITHUB_APP_CLIENT_ID / GITHUB_APP_CLIENT_SECRET (OAuth de l'App).
# La clé privée PEM peut être stockée avec des \n échappés.
# Les valeurs ci-dessous restent prioritaires sur la configuration en base.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# Google OAuth (obtenez-les sur console.cloud.google.com)
# URI de redirection autorisée : $GOOGLE_OAUTH_REDIRECT (config/domains.sh)
# Origine JavaScript autorisée : $PORTAL_URL            (config/domains.sh)
GOOGLE_CLIENT_ID="votre_google_client_id"
GOOGLE_CLIENT_SECRET="votre_google_client_secret"

# --- Captcha Cloudflare Turnstile (facultatif) ---
# Les deux clés doivent être renseignées, sinon aucun captcha n'est demandé.
# NEXT_PUBLIC_* est inlinée par Next au build : la définir puis relancer deploy.sh.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Statut public et maintenance -------------------------------------------
# true = le middleware renvoie la page /maintenance avec un HTTP 503 partout.
# Le basculement se fait sans rebuild : changer la valeur puis relancer
# `bash deploy.sh` (ou `docker compose ... up -d portail`).
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=""
# URL de l'API du moteur Axiom sondée par /api/status. Laisser vide tant qu'il
# n'est pas déployé : le composant apparaît alors « non surveillé ».
STATUS_ENGINE_URL=""
