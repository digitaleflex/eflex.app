// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Authentification (Better Auth) ─────────────────────────────────────────
// Modèles attendus par better-auth : user, session, account, verification.
// Le mot de passe e-mail est stocké dans Account.password (providerId = "credential").
model User {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  emailVerified Boolean       @default(false)
  image         String?
  // Plugin admin : rôle plateforme ("user" | "admin"), suspension.
  role          String?
  banned        Boolean       @default(false)
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]
  projects      Project[]
  members       Member[]
  invitations   Invitation[]  @relation("InvitationInviter")
  subscription  Subscription?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Session {
  id                   String   @id @default(cuid())
  expiresAt            DateTime
  token                String   @unique
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Plugin organization : organisation active de la session. Plugin admin : usurpation.
  activeOrganizationId String?
  impersonatedBy       String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ─── Multi-tenant (plugin organization) ─────────────────────────────────────
// Tout projet appartient à une organisation. Chaque utilisateur a une organisation
// personnelle créée à l'inscription. Rôles : owner, admin, member.
model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  logo        String?
  metadata    String?      @db.Text
  createdAt   DateTime     @default(now())
  members     Member[]
  invitations Invitation[]
  projects    Project[]
}

model Member {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  inviterId      String
  inviter        User         @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([email])
}

model Project {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String // créateur du projet
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  slug           String       @unique // ex: "mon-projet-42"
  repoUrl        String
  branch         String       @default("main")
  framework      String // laravel, nextjs, node, python, static
  runtime        String? // node@22, php@8.3, etc.
  domain         String? // domaine client, sans protocole
  coolifyAppId   String? // ID côté Coolify (null jusqu'au premier déploiement)
  coolifyWorkers Json? // applications Coolify des services annexes : { "queue": "uuid", … }
  plan           Json? // BuildPlan retenu à la création (voir packages/detector)
  detection      Json? // résultat de l'analyse : confiance, raisons, avertissements, commit
  port           Int          @default(80)
  envVars        EnvVar[]
  deployments    Deployment[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([userId])
  @@index([organizationId])
  @@index([slug])
}

model EnvVar {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key       String // ex: DATABASE_URL, NEXT_PUBLIC_URL
  value     String // chiffre au repos (libsodium ou pgcrypto)
  updatedAt DateTime @updatedAt

  @@unique([projectId, key])
  @@index([projectId])
}

model Deployment {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  commitSha      String
  status         String   @default("pending") // pending, building, deploying, live, failed, rollbacked
  coolifyBuildId String?
  logsSummary    String?  @db.Text
  createdAt      DateTime @default(now())

  @@index([projectId])
  @@index([status])
}

model Subscription {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status           String // active, cancelled, past_due, trialing
  plan             String // starter, pro, agency
  priceCents       Int      @default(0)
  providerRef      String?
  currentPeriodEnd DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
}

// ─── Administration de la plateforme ────────────────────────────────────────
// Journal d'audit en ajout seul : aucune route ne le modifie ni ne le supprime.
// `details` ne contient jamais de secret (valeurs de variables, jetons, mots de passe).
model AuditLog {
  id             String   @id @default(cuid())
  actorId        String?
  actorEmail     String // dénormalisé : l'entrée reste lisible si le compte est supprimé
  action         String // ex: "user.ban", "user.unban"
  targetType     String // user | organization | project | deployment | …
  targetId       String
  organizationId String?
  details        Json?
  ip             String?
  userAgent      String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([targetType, targetId])
  @@index([organizationId])
}

// ─── Temps réel ─────────────────────────────────────────────────────────────
// Bus d'événements : un seul flux SSE par onglet (/api/events). Les identifiants croissent,
// ce qui permet la reprise (Last-Event-ID). Les charges utiles ne contiennent jamais de secret.
// audience : "org" (membres de l'organisation), "admin" (administrateurs), "user" (un utilisateur).
model Event {
  id             BigInt   @id @default(autoincrement())
  type           String
  audience       String   @default("org")
  organizationId String?
  userId         String?
  payload        Json
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([organizationId, id])
}
